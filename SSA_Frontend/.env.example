# Base URL for the backend API.
# In production, this should point to your deployed Render URL: https://ssa-backend-sqli.onrender.com/api
# In local development, you can leave it empty to use Vite's proxy (configured in vite.config.ts) or point it to your local server.
VITE_API_URL=https://ssa-backend-sqli.onrender.com/api
